{
    "airbnb": {
        "command": "npx",
        "args": [
            "-y",
            "@openbnb/mcp-server-airbnb",
            "--ignore-robots-txt"
        ],
        "transport": "stdio"
    },
    "google-calendar": {
        "command": "npx",
        "args": ["@cocal/google-calendar-mcp"],
        "env": {
            "GOOGLE_OAUTH_CREDENTIALS": "./gcp-oauth.keys.json",
            "ENABLED_TOOLS": "list-events,create-event,get-current-time,update-event"
        },
        "transport": "stdio"
    }
}